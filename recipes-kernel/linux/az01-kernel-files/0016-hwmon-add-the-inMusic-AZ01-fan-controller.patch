diff --git a/drivers/hwmon/az01-fan.c b/drivers/hwmon/az01-fan.c
new file mode 100644
index 000000000000..e4fe0210d868
--- /dev/null
+++ b/drivers/hwmon/az01-fan.c
@@ -0,0 +1,242 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Fan controller of the inMusic AZ01 motorized players (Denon DJ SC5000M,
+ * SC6000M).
+ *
+ * The fans are not driven by the SoC. A microcontroller on UART1 runs them,
+ * and the host only asks it for a level and listens to what it reports:
+ *
+ *   host -> MCU   00 LL            set the fan level, 0..255
+ *   MCU -> host   01 AH AL BH BL   two big-endian 16-bit fan readings
+ *
+ * at 115200 baud, 8N1, no flow control. The level is the thermal cooling
+ * state, so the device tree's cooling maps drive the fans directly. The two
+ * readings are exposed unscaled as fan1_input and fan2_input.
+ *
+ * The protocol was read out of the vendor kernel's driver; this is a separate
+ * implementation of it. It has not been run on hardware.
+ */
+
+#include <linux/hwmon.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/serdev.h>
+#include <linux/spinlock.h>
+#include <linux/thermal.h>
+
+#define AZ01_FAN_BAUD		115200
+#define AZ01_FAN_MAX_STATE	255
+#define AZ01_FAN_CMD_LEVEL	0x00
+#define AZ01_FAN_RSP_SYNC	0x01
+#define AZ01_FAN_RSP_LEN	4	/* payload after the sync byte */
+#define AZ01_FAN_CHANNELS	2
+#define AZ01_FAN_WRITE_TIMEOUT	msecs_to_jiffies(100)
+
+struct az01_fan {
+	struct serdev_device *serdev;
+
+	/* Receive side: the frame being assembled, and the last complete one. */
+	spinlock_t rx_lock;
+	u8 rx_buf[AZ01_FAN_RSP_LEN];
+	int rx_pos;		/* -1: waiting for the sync byte */
+	u16 rpm[AZ01_FAN_CHANNELS];
+
+	/* Transmit side: the level last accepted by the MCU. */
+	struct mutex tx_lock;
+	unsigned long cur_state;
+};
+
+/*
+ * Feed one received byte to the frame parser. Returns true when it completed
+ * a frame and fan->rpm was updated. Bytes outside a frame are dropped until
+ * the next sync byte.
+ */
+static bool az01_fan_rx_byte(struct az01_fan *fan, u8 b)
+{
+	if (fan->rx_pos < 0) {
+		if (b == AZ01_FAN_RSP_SYNC)
+			fan->rx_pos = 0;
+		return false;
+	}
+
+	fan->rx_buf[fan->rx_pos++] = b;
+	if (fan->rx_pos < AZ01_FAN_RSP_LEN)
+		return false;
+
+	fan->rpm[0] = (fan->rx_buf[0] << 8) | fan->rx_buf[1];
+	fan->rpm[1] = (fan->rx_buf[2] << 8) | fan->rx_buf[3];
+	fan->rx_pos = -1;
+	return true;
+}
+
+static size_t az01_fan_receive_buf(struct serdev_device *serdev,
+				   const u8 *data, size_t count)
+{
+	struct az01_fan *fan = serdev_device_get_drvdata(serdev);
+	unsigned long flags;
+	size_t i;
+
+	spin_lock_irqsave(&fan->rx_lock, flags);
+	for (i = 0; i < count; i++)
+		az01_fan_rx_byte(fan, data[i]);
+	spin_unlock_irqrestore(&fan->rx_lock, flags);
+
+	return count;
+}
+
+static const struct serdev_device_ops az01_fan_serdev_ops = {
+	.receive_buf = az01_fan_receive_buf,
+	.write_wakeup = serdev_device_write_wakeup,
+};
+
+static int az01_fan_read(struct device *dev, enum hwmon_sensor_types type,
+			 u32 attr, int channel, long *val)
+{
+	struct az01_fan *fan = dev_get_drvdata(dev);
+	unsigned long flags;
+
+	if (type != hwmon_fan || attr != hwmon_fan_input ||
+	    channel < 0 || channel >= AZ01_FAN_CHANNELS)
+		return -EOPNOTSUPP;
+
+	spin_lock_irqsave(&fan->rx_lock, flags);
+	*val = fan->rpm[channel];
+	spin_unlock_irqrestore(&fan->rx_lock, flags);
+
+	return 0;
+}
+
+static const struct hwmon_ops az01_fan_hwmon_ops = {
+	.visible = 0444,
+	.read = az01_fan_read,
+};
+
+static const struct hwmon_channel_info * const az01_fan_hwmon_info[] = {
+	HWMON_CHANNEL_INFO(fan, HWMON_F_INPUT, HWMON_F_INPUT),
+	NULL
+};
+
+static const struct hwmon_chip_info az01_fan_chip_info = {
+	.ops = &az01_fan_hwmon_ops,
+	.info = az01_fan_hwmon_info,
+};
+
+static int az01_fan_get_max_state(struct thermal_cooling_device *cdev,
+				  unsigned long *state)
+{
+	*state = AZ01_FAN_MAX_STATE;
+	return 0;
+}
+
+static int az01_fan_get_cur_state(struct thermal_cooling_device *cdev,
+				  unsigned long *state)
+{
+	struct az01_fan *fan = cdev->devdata;
+
+	mutex_lock(&fan->tx_lock);
+	*state = fan->cur_state;
+	mutex_unlock(&fan->tx_lock);
+
+	return 0;
+}
+
+static int az01_fan_set_cur_state(struct thermal_cooling_device *cdev,
+				  unsigned long state)
+{
+	struct az01_fan *fan = cdev->devdata;
+	u8 cmd[2] = {
+		AZ01_FAN_CMD_LEVEL,
+		min_t(unsigned long, state, AZ01_FAN_MAX_STATE),
+	};
+	int ret;
+
+	mutex_lock(&fan->tx_lock);
+	ret = serdev_device_write(fan->serdev, cmd, sizeof(cmd),
+				  AZ01_FAN_WRITE_TIMEOUT);
+	if (ret == sizeof(cmd)) {
+		fan->cur_state = cmd[1];
+		ret = 0;
+	} else if (ret >= 0) {
+		ret = -EIO;
+	}
+	mutex_unlock(&fan->tx_lock);
+
+	return ret;
+}
+
+static const struct thermal_cooling_device_ops az01_fan_cooling_ops = {
+	.get_max_state = az01_fan_get_max_state,
+	.get_cur_state = az01_fan_get_cur_state,
+	.set_cur_state = az01_fan_set_cur_state,
+};
+
+static int az01_fan_probe(struct serdev_device *serdev)
+{
+	struct device *dev = &serdev->dev;
+	struct thermal_cooling_device *cdev;
+	struct device *hwmon;
+	struct az01_fan *fan;
+	int ret;
+
+	fan = devm_kzalloc(dev, sizeof(*fan), GFP_KERNEL);
+	if (!fan)
+		return -ENOMEM;
+
+	fan->serdev = serdev;
+	fan->rx_pos = -1;
+	spin_lock_init(&fan->rx_lock);
+	ret = devm_mutex_init(dev, &fan->tx_lock);
+	if (ret)
+		return ret;
+
+	serdev_device_set_drvdata(serdev, fan);
+	serdev_device_set_client_ops(serdev, &az01_fan_serdev_ops);
+
+	ret = devm_serdev_device_open(dev, serdev);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to open the UART\n");
+
+	serdev_device_set_baudrate(serdev, AZ01_FAN_BAUD);
+	serdev_device_set_flow_control(serdev, false);
+	ret = serdev_device_set_parity(serdev, SERDEV_PARITY_NONE);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to set parity\n");
+
+	hwmon = devm_hwmon_device_register_with_info(dev, "az01_fan", fan,
+						     &az01_fan_chip_info, NULL);
+	if (IS_ERR(hwmon))
+		return dev_err_probe(dev, PTR_ERR(hwmon),
+				     "failed to register hwmon device\n");
+
+	/*
+	 * The fan still reports through hwmon without a cooling device, so a
+	 * failure here is not fatal, as in the vendor driver. The thermal
+	 * framework sets the first level when it evaluates the trips.
+	 */
+	cdev = devm_thermal_of_cooling_device_register(dev, dev->of_node,
+						       "az01-fan", fan,
+						       &az01_fan_cooling_ops);
+	if (IS_ERR(cdev))
+		dev_warn(dev, "failed to register cooling device: %pe\n", cdev);
+
+	return 0;
+}
+
+static const struct of_device_id az01_fan_of_match[] = {
+	{ .compatible = "inmusic,az01-fan" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, az01_fan_of_match);
+
+static struct serdev_device_driver az01_fan_driver = {
+	.probe = az01_fan_probe,
+	.driver = {
+		.name = "az01-fan",
+		.of_match_table = az01_fan_of_match,
+	},
+};
+module_serdev_device_driver(az01_fan_driver);
+
+MODULE_DESCRIPTION("inMusic AZ01 fan controller");
+MODULE_LICENSE("GPL");
