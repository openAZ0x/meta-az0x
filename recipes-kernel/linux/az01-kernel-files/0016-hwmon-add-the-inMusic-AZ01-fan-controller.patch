diff --git a/Documentation/devicetree/bindings/hwmon/inmusic,az01-fan.yaml b/Documentation/devicetree/bindings/hwmon/inmusic,az01-fan.yaml
new file mode 100644
index 000000000000..ef1fea8eb2ed
--- /dev/null
+++ b/Documentation/devicetree/bindings/hwmon/inmusic,az01-fan.yaml
@@ -0,0 +1,38 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/hwmon/inmusic,az01-fan.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: inMusic AZ01 fan controller
+
+maintainers:
+  - Dylan Corrales <deathcamel58@gmail.com>
+
+description:
+  The fans of the inMusic AZ01 motorized players (Denon DJ SC5000M and
+  SC6000M) are run by a microcontroller on a UART. The host sets a fan level
+  of 0 to 255 and the microcontroller reports two fan readings. The node is a
+  child of the UART it is attached to.
+
+properties:
+  compatible:
+    const: inmusic,az01-fan
+
+  "#cooling-cells":
+    const: 2
+
+required:
+  - compatible
+  - "#cooling-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    serial {
+        fan {
+            compatible = "inmusic,az01-fan";
+            #cooling-cells = <2>;
+        };
+    };
